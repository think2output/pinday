# PinDay 환경 변수 견본
# 이 파일을 복사해 같은 폴더에 .env 파일을 만들고 값을 채운다. .env는 절대 커밋하지 않는다.
# NEXT_PUBLIC_ 로 시작하는 값만 화면 코드에 들어간다. 나머지는 서버에서만 쓴다.

# 카카오 지도 JavaScript 키 (화면 코드에 들어감, 카카오 앱 설정의 사이트 도메인 등록으로 보호)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# 카카오 REST API 키 (서버 전용: 카카오맵 대중교통·도보 경로, 카카오모빌리티 자동차 길찾기)
KAKAO_REST_API_KEY=

# 공공데이터포털 인증키 (서버 전용: TourAPI, 부산테마여행정보, 관광 빅데이터, 기상청 단기예보, 부산근현대역사관 아카이브)
DATA_GO_KR_SERVICE_KEY=

# 기상청 API허브 인증키 (서버 전용: 단기예보. apihub.kma.go.kr 마이페이지의 authKey)
KMA_APIHUB_AUTH_KEY=

# OpenAI API 키 (로컬 스크립트 전용: 도슨트 해설 미리 만들기. 월 사용 한도 먼저 설정)
OPENAI_API_KEY=

# 국가유산청 API는 키가 필요 없다.
